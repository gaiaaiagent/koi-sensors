[Unit]
Description=KOI Event Reconciliation
After=network.target

[Service]
Type=oneshot
User=darren
Group=gaia-devs
WorkingDirectory=/opt/projects/koi-sensors
EnvironmentFile=-/opt/projects/koi-sensors/.alert-config
ExecStart=/opt/projects/koi-sensors/scripts/reconcile-events.sh

[Install]
WantedBy=multi-user.target
