@prefix schema: <http://schema.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix reg: <https://regen.network/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# KOI Knowledge Graph Ontology - Base (v1.1)
# Defines core classes and properties for the Regen Network knowledge graph
# Extraction system using Schema.org, PROV, and custom Regen vocabularies

# Classes
schema:Person a rdfs:Class .
schema:Organization a rdfs:Class .
reg:Project a rdfs:Class .
schema:Place a rdfs:Class .
reg:Asset a rdfs:Class .
reg:Credit rdfs:subClassOf reg:Asset .
reg:Methodology a rdfs:Class .
reg:Event a rdfs:Class .
reg:Statement a rdfs:Class .

# Properties for provenance
reg:sourceRID a rdf:Property ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:string .

reg:sourceURL a rdf:Property ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:anyURI .

reg:extractionConfidence a rdf:Property ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:float .

reg:catReceiptId a rdf:Property ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:string .
