storage/podcast_complete/*.json
storage/podcast_transcribed/*.json
storage/podcast_final/*.json

# Keep the directory structure but not the data
!storage/podcast_complete/.gitkeep
!storage/podcast_transcribed/.gitkeep
!storage/podcast_final/.gitkeep

# Keep the transcript links file
!storage/notion_transcripts/transcript_links.json

