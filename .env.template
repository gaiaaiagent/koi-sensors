# Regen Network Indexing System - Environment Variables
# Copy this file to .env and fill in your API keys (all optional)

# Discourse Forums (optional - system works without for public content)
DISCOURSE_API_KEY_REGEN=
DISCOURSE_API_KEY_COMMONS=

# Discord Bot (optional - requires bot setup)
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=

# Twitter/X API (optional - for future implementation)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Notion API (optional - for future implementation)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# MCP Server Configuration
MCP_SERVER_URL=http://localhost:3000

# System Configuration
LOG_LEVEL=INFO
CACHE_TTL_HOURS=24
MAX_WORKERS=4
BATCH_SIZE=32

# Storage Paths (defaults work for most cases)
STORAGE_PATH=/home/regenai/project/indexing/storage
CACHE_PATH=/home/regenai/project/indexing/cache
LOG_PATH=/home/regenai/project/indexing/logs