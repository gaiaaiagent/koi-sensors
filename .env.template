# KOI Sensors Environment Variables Template
# Copy this file to .env and fill in your credentials

# ===========================================
# CORE CONFIGURATION
# ===========================================

# KOI System URLs
KOI_COORDINATOR_URL=http://localhost:8005
EVENT_BRIDGE_URL=http://localhost:8100

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# ===========================================
# DATA SOURCE CREDENTIALS
# ===========================================

# Notion API (REQUIRED for Notion sensor)
# Get from: https://www.notion.so/my-integrations
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Telegram Bot (REQUIRED for Telegram sensor)
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@your_channel_username

# Discord Bot (REQUIRED for Discord sensor)
# Create at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Twitter/X API (REQUIRED for Twitter sensor)
# Get from: https://developer.twitter.com/
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Discourse Forums (OPTIONAL - works without for public content)
# Get from forum admin panel if needed for private content
DISCOURSE_API_KEY_REGEN=
DISCOURSE_API_KEY_COMMONS=

# ===========================================
# NOTES
# ===========================================
# - Website sensor: No credentials needed
# - GitHub sensor: Works with public repos without auth
# - GitLab sensor: Works with public repos without auth
# - Discourse sensor: Works without API key for public content
# - Only add credentials for sensors you plan to use
# - NEVER commit this file with real credentials to Git
