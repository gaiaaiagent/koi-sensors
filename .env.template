# KOI Sensors Environment Variables Template
# Copy this file to .env and fill in your credentials

# ===========================================
# CORE CONFIGURATION
# ===========================================

# KOI System URLs
KOI_COORDINATOR_URL=http://localhost:8005
KOI_COORDINATOR_PORT=8005
EVENT_BRIDGE_URL=http://localhost:8100

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# ===========================================
# SENSOR POLLING INTERVALS (in seconds)
# ===========================================
POLL_INTERVAL=30                # Default for general sensors
CHECK_INTERVAL=3600             # Default check interval

# Individual sensor intervals
TWITTER_POLL_INTERVAL=1800      # 30 minutes
DISCOURSE_POLL_INTERVAL=3600    # 1 hour
NOTION_POLL_INTERVAL=1800       # 30 minutes
GITHUB_POLL_INTERVAL=3600       # 1 hour
GITLAB_POLL_INTERVAL=3600       # 1 hour
MEDIUM_POLL_INTERVAL=3600       # 1 hour
TELEGRAM_POLL_INTERVAL=300      # 5 minutes
WEBSITE_POLL_INTERVAL=1800      # 30 minutes
PODCAST_POLL_INTERVAL=7200      # 2 hours
LEDGER_POLL_INTERVAL=600        # 10 minutes
DISCORD_POLL_INTERVAL=3600      # 1 hour

# ===========================================
# DATA SOURCE CREDENTIALS
# ===========================================

# Notion API (REQUIRED for Notion sensor)
# Get from: https://www.notion.so/my-integrations
NOTION_API_KEY=

# Telegram Bot (REQUIRED for Telegram sensor)
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL=@your_channel_username

# Discord Bot (REQUIRED for Discord sensor)
# Create at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# Optional: Comma-separated guild IDs to monitor specific servers
DISCORD_GUILDS=

# Twitter/X Configuration (OPTIONAL - uses web scraping by default)
# For API access, get from: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# Accounts to monitor (comma-separated usernames without @)
TWITTER_ACCOUNTS=regen_network,RegenFdn,gregory_landua

# Discourse Forums (OPTIONAL - works without for public content)
# Get from forum admin panel if needed for private content
DISCOURSE_API_KEY_REGEN=
DISCOURSE_API_KEY_COMMONS=

# GitHub (OPTIONAL - for private repos)
# Create Personal Access Token at: https://github.com/settings/tokens
GITHUB_TOKEN=

# GitLab (OPTIONAL - for private repos)
# Create Personal Access Token in GitLab settings
GITLAB_TOKEN=

# Medium (No credentials needed - uses RSS/scraping)
# Configured in sensor directly

# Podcast (No credentials needed - uses RSS feeds)
# Configured in sensor directly

# Website (No credentials needed - web scraping)
# Configured in sensor directly

# Ledger (No credentials needed - uses public RPC endpoints)
# Configured in sensor directly

# ===========================================
# NOTES
# ===========================================
# - Website sensor: No credentials needed
# - GitHub sensor: Works with public repos without auth
# - GitLab sensor: Works with public repos without auth
# - Medium sensor: Uses RSS feeds and web scraping
# - Podcast sensor: Uses RSS feeds
# - Ledger sensor: Uses public RPC endpoints
# - Discourse sensor: Works without API key for public content
# - Twitter sensor: Works without API using web scraping
# - Only add credentials for sensors you plan to use
# - NEVER commit this file with real credentials to Git